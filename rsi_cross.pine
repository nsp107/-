//@version=6
// ─────────────────────────────────────────────────────────
// 전략 2: RSI 과매도 반등 (RSI Cross)
//
// 규칙: RSI가 30 아래로 내려갔다가 다시 위로 올라오면 매수,
//       70 위로 갔다가 아래로 내려오면 청산. 역추세 전략.
//
// 특징: MA Cross와 정반대 성격이다. 수직 상승하는 종목에서는
//       일찍 팔고 나가서 상승을 놓치고, 등락을 반복하는
//       종목에서는 저점 매수가 먹힌다.
// ─────────────────────────────────────────────────────────

strategy("RSI Cross", overlay = true,
     initial_capital       = 10000,
     default_qty_type      = strategy.percent_of_equity,
     default_qty_value     = 10,
     commission_type       = strategy.commission.percent,
     commission_value      = 0.055,
     slippage              = 2)

rsiLen = input.int(14, "RSI 기간",    minval = 2)
buyLv  = input.int(30, "매수 기준",   minval = 5,  maxval = 50)
sellLv = input.int(70, "매도 기준",   minval = 50, maxval = 95)

r = ta.rsi(close, rsiLen)

goLong = ta.crossover(r,  buyLv)
goFlat = ta.crossunder(r, sellLv)

if goLong
    strategy.entry("Long", strategy.long)
if goFlat
    strategy.close("Long")

// ─────────────────────────────────────────────────────────
// 결과 라벨
// ─────────────────────────────────────────────────────────
f(x) => str.tostring(x, "#.##")

var label lb = na

if barstate.islast
    float bigWin  = 0
    float fees    = 0
    float sumWin  = 0
    float sumLoss = 0

    if strategy.closedtrades > 0
        for i = 0 to strategy.closedtrades - 1
            p = strategy.closedtrades.profit(i)
            bigWin := math.max(bigWin, p)
            fees   := fees + strategy.closedtrades.commission(i)
            if p > 0
                sumWin  := sumWin  + p
            else
                sumLoss := sumLoss + math.abs(p)

    net     = strategy.netprofit
    netPct  = net / strategy.initial_capital * 100
    ddPct   = strategy.max_drawdown / strategy.initial_capital * 100
    winN    = strategy.wintrades
    lossN   = strategy.losstrades
    winPct  = strategy.closedtrades > 0 ? winN / strategy.closedtrades * 100 : 0
    avgWin  = winN  > 0 ? sumWin  / winN  : 0
    avgLoss = lossN > 0 ? sumLoss / lossN : 0
    ratio   = avgLoss > 0 ? avgWin / avgLoss : 0

    txt = "순수익: " + f(net) + " (" + f(netPct) + "%)"
       + "\n매매 횟수: " + str.tostring(strategy.closedtrades)
       + "\n승률: " + f(winPct) + "%"
       + "\n최대 낙폭: " + f(ddPct) + "%"
       + "\n평균 수익: " + f(avgWin)
       + "\n평균 손실: " + f(avgLoss)
       + "\n손익비: " + f(ratio) + "   (승률x손익비 > 1 이어야 생존)"
       + "\n최대 수익 거래: " + f(bigWin)
       + "\n그 한 번 빼면: " + f(net - bigWin)
       + "\n총 수수료: " + f(fees)

    label.delete(lb)
    lb := label.new(bar_index, high * 1.05, txt,
         style     = label.style_label_lower_left,
         color     = color.white,
         textcolor = color.black,
         size      = size.normal)
