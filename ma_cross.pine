//@version=6
// ─────────────────────────────────────────────────────────
// 전략 1: 이동평균 교차 (MA Cross)
//
// 규칙: 단기 이평선이 장기 이평선을 위로 뚫으면 매수,
//       아래로 뚫으면 청산. 가장 기본적인 추세추종.
//
// 사용법: 파인 에디터 → 새로 만들기 → 전략 → 전체 붙여넣기
//         → 저장 → 지표 메뉴 → 내 스크립트에서 추가
// ─────────────────────────────────────────────────────────

strategy("MA Cross", overlay = true,
     initial_capital       = 10000,
     default_qty_type      = strategy.percent_of_equity,
     default_qty_value     = 10,          // 자산의 10%만 사용 (100%는 비현실적)
     commission_type       = strategy.commission.percent,
     commission_value      = 0.055,       // 바이비트 테이커 수수료
     slippage              = 2)

fastLen = input.int(20, "단기 이동평균", minval = 2)
slowLen = input.int(60, "장기 이동평균", minval = 5)

maFast = ta.sma(close, fastLen)
maSlow = ta.sma(close, slowLen)

goLong = ta.crossover(maFast,  maSlow)
goFlat = ta.crossunder(maFast, maSlow)

if goLong
    strategy.entry("Long", strategy.long)
if goFlat
    strategy.close("Long")

plot(maFast, "MA fast", color = color.orange)
plot(maSlow, "MA slow", color = color.blue)

// ─────────────────────────────────────────────────────────
// 결과 라벨 (모바일 앱은 전략 테스터가 없어서 차트에 직접 출력)
// ─────────────────────────────────────────────────────────
f(x) => str.tostring(x, "#.##")

var label lb = na

if barstate.islast
    float bigWin  = 0
    float fees    = 0
    float sumWin  = 0
    float sumLoss = 0

    if strategy.closedtrades > 0
        for i = 0 to strategy.closedtrades - 1
            p = strategy.closedtrades.profit(i)
            bigWin := math.max(bigWin, p)
            // 수수료는 거래별로 직접 더해야 한다.
            // grossprofit+grossloss-netprofit 같은 식은 수수료가 아니다.
            fees := fees + strategy.closedtrades.commission(i)
            if p > 0
                sumWin  := sumWin  + p
            else
                sumLoss := sumLoss + math.abs(p)

    net     = strategy.netprofit
    netPct  = net / strategy.initial_capital * 100
    ddPct   = strategy.max_drawdown / strategy.initial_capital * 100
    winN    = strategy.wintrades
    lossN   = strategy.losstrades
    winPct  = strategy.closedtrades > 0 ? winN / strategy.closedtrades * 100 : 0
    avgWin  = winN  > 0 ? sumWin  / winN  : 0
    avgLoss = lossN > 0 ? sumLoss / lossN : 0
    ratio   = avgLoss > 0 ? avgWin / avgLoss : 0

    txt = "순수익: " + f(net) + " (" + f(netPct) + "%)"
       + "\n매매 횟수: " + str.tostring(strategy.closedtrades)
       + "\n승률: " + f(winPct) + "%"
       + "\n최대 낙폭: " + f(ddPct) + "%"
       + "\n평균 수익: " + f(avgWin)
       + "\n평균 손실: " + f(avgLoss)
       + "\n손익비: " + f(ratio) + "   (승률x손익비 > 1 이어야 생존)"
       + "\n최대 수익 거래: " + f(bigWin)
       + "\n그 한 번 빼면: " + f(net - bigWin)
       + "\n총 수수료: " + f(fees)

    label.delete(lb)
    lb := label.new(bar_index, high * 1.05, txt,
         style     = label.style_label_lower_left,
         color     = color.white,
         textcolor = color.black,
         size      = size.normal)
